# Private Key for deployment (NEVER commit real private key)
PRIVATE_KEY=your_private_key_here

# Base Mainnet RPC URL
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia Testnet RPC URL
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Base Explorer API Key (optional)
BASE_EXPLORER_API_KEY=your_base_explorer_api_key_here

# Multi-sig addresses for production
MULTI_SIG_1=0x...
MULTI_SIG_2=0x...
MULTI_SIG_3=0x...

# Treasury configuration
TREASURY_PAYEES=0x...,0x...,0x...
TREASURY_SHARES=40,30,30

# Initial token distribution
INITIAL_OWNER=0x...
COMMUNITY_FUND=0x...
VERIFIER_ADDRESS=0x...

# Platform fees (in basis points, 10000 = 100%)
PLATFORM_FEE=250  # 2.5%
VERIFICATION_FEE=1000000000000000  # 0.001 ETH

# Governance parameters
VOTING_PERIOD=604800  # 7 days in seconds
VOTING_DELAY=86400    # 1 day in seconds
PROPOSAL_THRESHOLD=1000000000000000000000000  # 1M BGT
QUORUM_PERCENTAGE=4  # 4%

# Time lock parameters
TIMELOCK_DELAY=172800  # 2 days in seconds
