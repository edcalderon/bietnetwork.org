{
  "name": "biet-network",
  "version": "0.2.5",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/set-version.js && turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "deploy": "node scripts/set-version.js && turbo run deploy",
    "version": "node scripts/set-version.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "changelog": "node scripts/update-changelog.js",
    "contracts:build": "turbo run build --filter=contracts",
    "contracts:test": "turbo run test --filter=contracts",
    "contracts:deploy": "turbo run deploy --filter=contracts",
    "web:dev": "turbo run dev --filter=@biet-network/web",
    "web:build": "node scripts/set-version.js && turbo run build --filter=@biet-network/web",
    "web:deploy": "node scripts/set-version.js && turbo run deploy --filter=@biet-network/web"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@tanstack/query-core": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "eslint": "^8.42.0",
    "husky": "^8.0.0",
    "prettier": "^3.0.0",
    "standard-version": "^9.5.0",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.5.3"
}