{
  "name": "biet-network",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "deploy": "turbo run deploy",
    "contracts:build": "turbo run build --filter=contracts",
    "contracts:test": "turbo run test --filter=contracts",
    "contracts:deploy": "turbo run deploy --filter=contracts",
    "web:dev": "turbo run dev --filter=web",
    "web:build": "turbo run build --filter=web",
    "web:deploy": "turbo run deploy --filter=web"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "eslint": "^8.42.0",
    "husky": "^8.0.0",
    "prettier": "^3.0.0",
    "standard-version": "^9.5.0",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.5.3"
}
