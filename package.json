{
  "name": "biet-network",
  "version": "0.2.21",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/set-version.js && turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "deploy": "node scripts/set-version.js && turbo run deploy",
    "version": "node scripts/set-version.js",
    "version:patch": "node scripts/bump-version.js patch && npm run changelog",
    "version:minor": "node scripts/bump-version.js minor && npm run changelog",
    "version:major": "node scripts/bump-version.js major && npm run changelog",
    "changelog": "node scripts/update-changelog.js",
    "contracts:build": "turbo run build --filter=contracts",
    "contracts:test": "turbo run test --filter=contracts",
    "contracts:deploy": "turbo run deploy --filter=contracts",
    "web:dev": "turbo run dev --filter=@biet-network/web",
    "web:dev:docs": "concurrently \"yarn web:dev\" \"cd apps/docs && NODE_ENV=development yarn start --port 3001\"",
    "web:build": "node scripts/set-version.js && cd apps/docs && yarn build:copy && cd ../web && turbo run build --filter=@biet-network/web",
    "web:deploy": "node scripts/set-version.js && turbo run deploy --filter=@biet-network/web"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@tanstack/query-core": "^5.0.0",
    "@tanstack/react-query": "^5.90.10",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.42.0",
    "husky": "^8.0.0",
    "prettier": "^3.0.0",
    "standard-version": "^9.5.0",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@4.5.3",
  "dependencies": {
    "@biet-network/sdk": "workspace:^",
    "@types/three": "^0.181.0",
    "bs58": "^6.0.0",
    "concurrently": "^8.2.2",
    "lucide-react": "^0.554.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.181.1",
    "viem": "^2.39.0",
    "wagmi": "^2.19.4",
    "ws": "^8.18.3"
  }
}